# Copy as .env.user-admin and replace the values. Configuration of the user administration commands
# (create-user, enable-totp, reset-totp), which connect with the users role, not with the server's.
AUTH_LANG=es
PGHOST=localhost
PGPORT=5432
PGDATABASE=gate_one
PGUSER=gate_one_user_admin
PGPASSWORD=replace-with-the-role-password
# The same key as the server's: enable-totp encrypts the secrets the server decrypts.
AUTH_TOTP_KEY=replace-with-the-servers-key
# SCRAM-SHA-256 parameters for new passwords. PostgreSQL's by default (4096 and 16).
#AUTH_SCRAM_ITERATIONS=4096
#AUTH_SCRAM_SALT_LENGTH=16
