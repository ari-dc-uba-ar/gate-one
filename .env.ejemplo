# Copiar como .env y reemplazar los valores. Este archivo no se versiona con valores reales.
AUTH_EMISOR=http://localhost:3993
AUTH_PUERTO=3993
# Claves de firma de cookies, separadas por coma. Generar con: openssl rand -base64 32
AUTH_CLAVES_DE_COOKIES=reemplazar-por-una-clave-aleatoria
AUTH_CLIENTE_ID=one-entrance
# Secreto compartido con one-entrance. Generar con: openssl rand -base64 32
AUTH_CLIENTE_SECRETO=reemplazar-por-un-secreto-aleatorio
AUTH_URL_DE_RETORNO=http://localhost:3004/callback
AUTH_URL_DE_LOGOUT_BACKCHANNEL=http://localhost:3004/backchannel-logout
AUTH_URL_POSTERIOR_AL_LOGOUT=http://localhost:3004/
AUTH_RECURSO=http://localhost:3004/api
AUTH_ALCANCE=perfil:leer
AUTH_DURACION_ACCESS_TOKEN=600
