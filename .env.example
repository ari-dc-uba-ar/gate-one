# Copy as .env and replace the values. This file is not versioned with real values.
# Language of the messages: en (default) or es.
AUTH_LANG=es
# Database: the standard PostgreSQL variables (the schema is created with install/schema.sql).
PGHOST=localhost
PGPORT=5432
PGDATABASE=gate_one
PGUSER=gate_one_app
PGPASSWORD=replace-with-the-role-password
AUTH_ISSUER=http://localhost:3993
AUTH_PORT=3993
# Cookie signing keys, comma separated. Generate with: openssl rand -base64 32
AUTH_COOKIE_KEYS=replace-with-a-random-key
# Clients (services) and APIs are registered in the database; see install/example-client.sql.
# Session lifetime in seconds (default 8 hours). The session cookie also ends when the browser is closed.
#AUTH_SESSION_TTL=28800
# SCRAM-SHA-256 parameters for new passwords. PostgreSQL's by default (4096 and 16).
# Changing them does not affect the stored ones: each verifier carries its own parameters.
#AUTH_SCRAM_ITERATIONS=4096
#AUTH_SCRAM_SALT_LENGTH=16
